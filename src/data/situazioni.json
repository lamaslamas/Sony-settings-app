  "metodoZebre": {
    "titolo": "Metodo zebre + compensazione",
    "quando": "Scegli la modalità in base alla luce.",
    "modalita": {
      "isoAuto": {
        "nome": "M + ISO AUTO",
        "consigliata": "Consigliata con la luce che cambia di continuo.",
        "intro": "Tempo e diaframma li scegli tu, gli ISO la fotocamera. La fotocamera cerca un'esposizione “media” e tende a schiarire lo sfondo scuro, bruciando le parti chiare del soggetto: si corregge con la compensazione.",
        "passi": [
          "Imposta tempo e diaframma come sempre e ISO su ISO AUTO, con limite massimo (Exposure/Color › Exposure › ISO Range Limit).",
          "Inquadra il soggetto.",
          "Se vedi le strisce sulla parte più chiara, gira la ghiera della compensazione verso il meno: −0,3, −0,7, −1…",
          "Fermati appena le strisce spariscono.",
          "Scatta o registra."
        ],
        "nota": "Con sfondo scuro di solito si finisce tra −1 e −2: è la sottoesposizione voluta, si recupera in Lightroom."
      },
      "isoFisso": {
        "nome": "M con ISO fisso",
        "consigliata": "Quando la luce è stabile e vuoi il controllo completo.",
        "intro": "Gli ISO li scegli tu: la compensazione qui non ha effetto.",
        "passi": [
          "Imposta tempo, diaframma e ISO a mano.",
          "Inquadra il soggetto.",
          "Gira la ghiera di controllo sugli ISO finché le strisce spariscono dal soggetto.",
          "Scatta o registra."
        ],
        "nota": "La ghiera di compensazione non cambia niente con ISO fisso."
      }
    },
    "comeLeggereZebraVideo": [
      "Zebra Level 70, per la pelle: zebre leggere sul volto ben esposto.",
      "Niente zebre sul volto: probabilmente sottoesposto.",
      "Zebre su gran parte del volto: troppo esposto.",
      "Alternativa 100+: serve a controllare le alte luci bruciate (finestre, lampade)."
    ]
  },
